# Copy to .env and fill in. Never commit .env.

# Opencode Go OpenAI-compatible endpoint
OPENCODE_BASE_URL=
OPENCODE_API_KEY=

# Comma-separated model IDs, taken from `runner.py --list-models`
MODELS=

# Optional: USD per million tokens, used only to show money in the dry-run estimate
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
